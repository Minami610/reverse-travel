{
  "name": "reverse-travel",
  "version": "0.1.0",
  "description": "逆引き旅行アプリ - 予算を入れたら、行ける場所が出てくる（香川県版公開済み、全国対応へ移行中）",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "build": "node scripts/fetch-and-build.js",
    "build-prefecture": "node scripts/build-prefecture.js",
    "compare-prefecture-build": "node scripts/compare-prefecture-build.js",
    "bundle": "node scripts/bundle-html.js",
    "refresh-spots": "node scripts/build-pipeline/refresh-and-normalize-spots.js",
    "generate-route-details": "node scripts/build-pipeline/generate-route-details.js",
    "verify-render": "node scripts/verify-initial-render.js",
    "verify-regression": "node scripts/verify-regression.js",
    "test:wikidata": "node scripts/test-wikidata.js",
    "test:spot-candidates": "node scripts/test-spot-candidates.js",
    "dev": "echo 'Open index.html with Live Server'"
  },
  "keywords": [
    "travel",
    "GTFS",
    "reverse-search",
    "budget",
    "public-transport"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "csv-parse": "^5.4.1",
    "leaflet": "^1.9.4",
    "node-fetch": "^3.3.1"
  },
  "devDependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "jsdom": "^30.0.1",
    "shapefile": "^0.6.6"
  }
}
